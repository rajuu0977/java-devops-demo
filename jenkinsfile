pipeline {
    agent any

    stages {

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t java-devops-demo:jenkins .'
                sh 'minikube image load java-devops-demo:jenkins'
            }
        }

        stage('Kubernetes Deploy') {
            steps {
                sh 'kubectl apply -f /var/lib/jenkins/java-devops-demo/deployment.yaml'
                sh 'kubectl apply -f /var/lib/jenkins/java-devops-demo/service.yaml'
            }
        }
    }
}
